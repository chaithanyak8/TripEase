datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  HR_MANAGER
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_NOTICE
  ARCHIVED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
  LATE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum OvertimeStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum PayrollStatus {
  DRAFT
  PROCESSING
  PROCESSED
  PAID
}

enum NotificationType {
  LEAVE
  OVERTIME
  PAYROLL
  PAYSLIP
  ATTENDANCE
  ANNOUNCEMENT
}

model User {
  id                  Int                  @id @default(autoincrement())
  email               String               @unique
  passwordHash        String
  role                Role                 @default(EMPLOYEE)
  status              UserStatus           @default(ACTIVE)
  employeeId          Int?                 @unique
  employee            Employee?            @relation("UserToEmployee", fields: [employeeId], references: [id])
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  lastLogin           DateTime?
  auditLogs           AuditLog[]
  notifications       Notification[]
  passwordResetTokens PasswordResetToken[]
  approvedLeaves      LeaveRequest[]       @relation("LeaveApprover")
  approvedOvertimes   Overtime[]           @relation("OvertimeApprover")
  processedPayrolls   Payroll[]            @relation("PayrollProcessor")

  @@index([email])
  @@index([role])
}

model Employee {
  id               Int               @id @default(autoincrement())
  employeeCode     String            @unique
  userId           Int?              @unique
  user             User?             @relation("UserToEmployee")
  fullName         String
  email            String            @unique
  phone            String?
  dateOfBirth      DateTime?
  gender           String?
  address          String?           @db.Text
  departmentId     Int?
  department       Department?       @relation(fields: [departmentId], references: [id])
  designation      String
  joiningDate      DateTime
  employmentType   EmploymentType    @default(FULL_TIME)
  managerId        Int?
  manager          Employee?         @relation("ManagerSubordinates", fields: [managerId], references: [id])
  subordinates     Employee[]        @relation("ManagerSubordinates")
  basicSalary      Decimal           @db.Decimal(12, 2)
  status           EmployeeStatus    @default(ACTIVE)
  profileImage     String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  attendances      Attendance[]
  leaveBalances    LeaveBalance[]
  leaveRequests    LeaveRequest[]
  overtimes        Overtime[]
  salaryStructures SalaryStructure[]
  payrolls         Payroll[]
  payslips         Payslip[]

  @@index([employeeCode])
  @@index([email])
  @@index([departmentId])
  @@index([status])
}

model Department {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  description String?    @db.Text
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  employees   Employee[]

  @@index([name])
}

model Attendance {
  id              Int              @id @default(autoincrement())
  employeeId      Int
  employee        Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date            DateTime         @db.Date
  checkIn         DateTime?
  checkOut        DateTime?
  breakMinutes    Int              @default(0)
  workingMinutes  Int              @default(0)
  lateMinutes     Int              @default(0)
  overtimeMinutes Int              @default(0)
  status          AttendanceStatus @default(PRESENT)
  notes           String?          @db.Text
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  overtimes       Overtime[]

  @@unique([employeeId, date])
  @@index([date])
  @@index([employeeId])
  @@index([status])
}

model LeaveType {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  defaultDays   Int            @default(0)
  isPaid        Boolean        @default(true)
  status        String         @default("ACTIVE")
  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]

  @@index([name])
}

model LeaveBalance {
  id            Int       @id @default(autoincrement())
  employeeId    Int
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId   Int
  leaveType     LeaveType @relation(fields: [leaveTypeId], references: [id])
  year          Int
  allocatedDays Decimal   @db.Decimal(5, 1)
  usedDays      Decimal   @default(0) @db.Decimal(5, 1)
  remainingDays Decimal   @db.Decimal(5, 1)

  @@unique([employeeId, leaveTypeId, year])
  @@index([employeeId])
  @@index([year])
}

model LeaveRequest {
  id              Int         @id @default(autoincrement())
  employeeId      Int
  employee        Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId     Int
  leaveType       LeaveType   @relation(fields: [leaveTypeId], references: [id])
  startDate       DateTime    @db.Date
  endDate         DateTime    @db.Date
  numberOfDays    Decimal     @db.Decimal(5, 1)
  reason          String      @db.Text
  status          LeaveStatus @default(PENDING)
  approvedBy      Int?
  approver        User?       @relation("LeaveApprover", fields: [approvedBy], references: [id])
  approvedAt      DateTime?
  rejectionReason String?     @db.Text
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([startDate, endDate])
}

model Overtime {
  id           Int            @id @default(autoincrement())
  employeeId   Int
  employee     Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendanceId Int?
  attendance   Attendance?    @relation(fields: [attendanceId], references: [id], onDelete: SetNull)
  date         DateTime       @db.Date
  minutes      Int
  ratePerHour  Decimal        @db.Decimal(10, 2)
  amount       Decimal        @db.Decimal(12, 2)
  status       OvertimeStatus @default(PENDING)
  approvedBy   Int?
  approver     User?          @relation("OvertimeApprover", fields: [approvedBy], references: [id])
  approvedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([date])
}

model SalaryStructure {
  id               Int       @id @default(autoincrement())
  employeeId       Int
  employee         Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  basicSalary      Decimal   @db.Decimal(12, 2)
  hra              Decimal   @default(0) @db.Decimal(12, 2)
  travelAllowance  Decimal   @default(0) @db.Decimal(12, 2)
  medicalAllowance Decimal   @default(0) @db.Decimal(12, 2)
  otherAllowance   Decimal   @default(0) @db.Decimal(12, 2)
  overtimeRate     Decimal   @default(0) @db.Decimal(10, 2)
  effectiveFrom    DateTime  @db.Date
  effectiveTo      DateTime? @db.Date
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([employeeId])
}

model Payroll {
  id              Int           @id @default(autoincrement())
  employeeId      Int
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month           Int
  year            Int
  basicSalary     Decimal       @db.Decimal(12, 2)
  totalAllowances Decimal       @db.Decimal(12, 2)
  overtimePay     Decimal       @default(0) @db.Decimal(12, 2)
  grossSalary     Decimal       @db.Decimal(12, 2)
  leaveDeduction  Decimal       @default(0) @db.Decimal(12, 2)
  lateDeduction   Decimal       @default(0) @db.Decimal(12, 2)
  loanDeduction   Decimal       @default(0) @db.Decimal(12, 2)
  otherDeduction  Decimal       @default(0) @db.Decimal(12, 2)
  totalDeductions Decimal       @db.Decimal(12, 2)
  netSalary       Decimal       @db.Decimal(12, 2)
  status          PayrollStatus @default(DRAFT)
  processedAt     DateTime?
  processedBy     Int?
  processor       User?         @relation("PayrollProcessor", fields: [processedBy], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  payslip         Payslip?

  @@unique([employeeId, month, year])
  @@index([month, year])
  @@index([status])
}

model Payslip {
  id            Int      @id @default(autoincrement())
  payrollId     Int      @unique
  payroll       Payroll  @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  employeeId    Int
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payslipNumber String   @unique
  month         Int
  year          Int
  pdfPath       String?
  generatedAt   DateTime @default(now())

  @@index([employeeId])
  @@index([month, year])
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String           @db.Text
  type      NotificationType @default(ANNOUNCEMENT)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([isRead])
}

model Holiday {
  id         Int      @id @default(autoincrement())
  name       String
  date       DateTime @db.Date
  isOptional Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([date])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  details   String?  @db.Text
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
}

model CompanySettings {
  id                     Int      @id @default(autoincrement())
  companyName            String   @default("WorkForce360 Technologies India Pvt Ltd")
  companyAddress         String?  @db.Text
  companyEmail           String?
  companyPhone           String?
  officeStartTime        String   @default("09:30")
  officeEndTime          String   @default("18:30")
  breakMinutes           Int      @default(60)
  requiredWorkingMinutes Int      @default(480)
  lateThresholdMinutes   Int      @default(15)
  defaultOvertimeRate    Decimal  @default(200.00) @db.Decimal(10, 2)
  updatedAt              DateTime @updatedAt
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}
